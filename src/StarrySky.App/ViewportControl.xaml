<UserControl
    x:Class="StarrySky.App.ViewportControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- SwapChainPanel itself takes no background: giving it one crashes the
         compositor. A transparent Grid on top carries the pointer input. -->
    <Grid x:Name="InputLayer" Background="Transparent">
        <SwapChainPanel x:Name="Panel" />
    </Grid>
</UserControl>
