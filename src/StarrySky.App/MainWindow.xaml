<Window
    x:Class="StarrySky.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StarrySky.App"
    Title="星空">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <MenuBar Grid.Row="0">
            <MenuBarItem Title="文件">
                <MenuFlyoutItem Text="新建">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="打开…" />
                <MenuFlyoutItem Text="保存" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="导出 FBX…" />
            </MenuBarItem>
            <MenuBarItem Title="编辑">
                <MenuFlyoutItem Text="删除" />
                <MenuFlyoutItem Text="复制" />
            </MenuBarItem>
            <MenuBarItem Title="视图">
                <MenuFlyoutItem Text="线框" />
                <MenuFlyoutItem Text="着色" />
            </MenuBarItem>
            <MenuBarItem Title="帮助">
                <MenuFlyoutItem Text="关于星空" />
            </MenuBarItem>
        </MenuBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Padding="4,8"
                Spacing="4"
                Background="#CC16171A">
                <Button Width="36" Height="36" Content="➤" ToolTipService.ToolTip="选择（Q）" />
                <Button Width="36" Height="36" Content="✥" ToolTipService.ToolTip="移动（W）" />
                <Button Width="36" Height="36" Content="⟳" ToolTipService.ToolTip="旋转（E）" />
                <Button Width="36" Height="36" Content="⤢" ToolTipService.ToolTip="缩放（R）" />
                <Button Width="36" Height="36" Content="＋" ToolTipService.ToolTip="添加基本体" />
            </StackPanel>

            <local:ViewportControl
                x:Name="ViewportHost"
                Grid.Column="1" />

            <Grid Grid.Column="2" Background="#CC16171A">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="12,12,12,4"
                    FontWeight="SemiBold"
                    Text="大纲" />
                <ListView Grid.Row="0" Margin="8,36,8,8" />

                <Rectangle
                    Grid.Row="1"
                    Height="1"
                    Fill="#33FFFFFF" />

                <TextBlock
                    Grid.Row="2"
                    Margin="12,12,12,4"
                    FontWeight="SemiBold"
                    Text="属性" />
            </Grid>
        </Grid>

        <Border
            Grid.Row="2"
            Height="26"
            Background="#CC121316">
            <TextBlock
                x:Name="StatusText"
                Margin="12,0"
                VerticalAlignment="Center"
                FontSize="12"
                Opacity="0.75"
                Text="就绪" />
        </Border>
    </Grid>
</Window>
