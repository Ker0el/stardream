<Window
    x:Class="StarDream.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StarDream.App"
    Title="星梦">

    <Grid>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F8" Invoked="OnToggleEditMode" />
            <KeyboardAccelerator Key="F9" Invoked="OnVertexMode" />
            <KeyboardAccelerator Key="F10" Invoked="OnEdgeMode" />
            <KeyboardAccelerator Key="F11" Invoked="OnFaceMode" />
            <KeyboardAccelerator Key="Q" Invoked="OnSelectTool" />
            <KeyboardAccelerator Key="W" Invoked="OnTranslateTool" />
            <KeyboardAccelerator Key="E" Invoked="OnRotateTool" />
            <KeyboardAccelerator Key="R" Invoked="OnScaleTool" />
            <KeyboardAccelerator Key="F" Invoked="OnFrameSelected" />
            <KeyboardAccelerator Key="Delete" Invoked="OnDeleteKey" />
            <KeyboardAccelerator Key="D" Modifiers="Control" Invoked="OnDuplicateKey" />
            <KeyboardAccelerator Key="E" Modifiers="Control" Invoked="OnExtrudeKey" />
            <KeyboardAccelerator Key="X" Modifiers="Control" Invoked="OnCutKey" />
            <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="OnCopyKey" />
            <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="OnPasteKey" />
            <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="OnUndoKey" />
            <KeyboardAccelerator Key="Y" Modifiers="Control" Invoked="OnRedoKey" />
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnNewKey" />
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OnOpenKey" />
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="OnSaveKey" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <MenuBar Grid.Row="0">
            <MenuBarItem Title="文件">
                <MenuFlyoutItem Text="新建" Click="OnNewScene" />
                <MenuFlyoutItem Text="打开…" Click="OnOpenScene" />
                <MenuFlyoutItem Text="保存" Click="OnSaveScene" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="导出 FBX…" Click="OnExportFbx" />
            </MenuBarItem>
            <MenuBarItem Title="编辑">
                <MenuFlyoutItem Text="撤销" Click="OnUndo" />
                <MenuFlyoutItem Text="重做" Click="OnRedo" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="剪切" Click="OnCut" />
                <MenuFlyoutItem Text="复制" Click="OnCopy" />
                <MenuFlyoutItem Text="粘贴" Click="OnPaste" />
                <MenuFlyoutItem Text="再制一份" Click="OnDuplicate" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="删除" Click="OnDelete" />
            </MenuBarItem>
            <MenuBarItem Title="视图">
                <MenuFlyoutItem Text="全览" Click="OnFrameAll" />
            </MenuBarItem>
            <MenuBarItem Title="帮助">
                <MenuFlyoutItem Text="关于星梦" />
            </MenuBarItem>
        </MenuBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Padding="4,8"
                Spacing="4"
                Background="#CC16171A">
                <Button Width="36" Height="36" Content="➕" ToolTipService.ToolTip="添加立方体" Click="OnAddCube" />
                <Button Width="36" Height="36" Content="●" ToolTipService.ToolTip="添加球体" Click="OnAddSphere" />
                <Button Width="36" Height="36" Content="⬭" ToolTipService.ToolTip="添加圆柱" Click="OnAddCylinder" />
                <Button Width="36" Height="36" Content="▪" ToolTipService.ToolTip="添加平面" Click="OnAddPlane" />
            </StackPanel>

            <local:ViewportControl
                x:Name="ViewportHost"
                Grid.Column="1" />

            <Grid Grid.Column="2" Background="#CC16171A">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="12,12,12,4"
                    FontWeight="SemiBold"
                    Text="大纲" />
                <ListView
                    x:Name="OutlinerList"
                    Grid.Row="0"
                    Margin="8,36,8,8"
                    KeyDown="OnOutlinerKeyDown"
                    SelectionChanged="OnOutlinerSelectionChanged" />

                <Rectangle
                    Grid.Row="1"
                    Height="1"
                    Fill="#33FFFFFF" />

                <ScrollViewer
                    Grid.Row="2"
                    Margin="12,8,12,12">
                    <StackPanel Spacing="6">
                        <TextBlock
                            Margin="0,4,0,0"
                            FontWeight="SemiBold"
                            Text="属性" />

                        <TextBlock FontSize="12" Opacity="0.6" Text="名称" />
                        <TextBox x:Name="NameBox" TextChanged="OnPropertyEdited" />

                        <TextBlock FontSize="12" Opacity="0.6" Text="位置" />
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <NumberBox x:Name="PosX" Grid.Column="0" SmallChange="0.1" ValueChanged="OnNumberChanged" />
                            <NumberBox x:Name="PosY" Grid.Column="1" SmallChange="0.1" ValueChanged="OnNumberChanged" />
                            <NumberBox x:Name="PosZ" Grid.Column="2" SmallChange="0.1" ValueChanged="OnNumberChanged" />
                        </Grid>

                        <TextBlock FontSize="12" Opacity="0.6" Text="旋转" />
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <NumberBox x:Name="RotX" Grid.Column="0" SmallChange="1" ValueChanged="OnNumberChanged" />
                            <NumberBox x:Name="RotY" Grid.Column="1" SmallChange="1" ValueChanged="OnNumberChanged" />
                            <NumberBox x:Name="RotZ" Grid.Column="2" SmallChange="1" ValueChanged="OnNumberChanged" />
                        </Grid>

                        <TextBlock FontSize="12" Opacity="0.6" Text="缩放" />
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <NumberBox x:Name="ScaleX" Grid.Column="0" SmallChange="0.1" ValueChanged="OnNumberChanged" />
                            <NumberBox x:Name="ScaleY" Grid.Column="1" SmallChange="0.1" ValueChanged="OnNumberChanged" />
                            <NumberBox x:Name="ScaleZ" Grid.Column="2" SmallChange="0.1" ValueChanged="OnNumberChanged" />
                        </Grid>

                        <TextBlock FontSize="12" Opacity="0.6" Text="颜色" />
                        <TextBox x:Name="ColorBox" PlaceholderText="#C8C8C8" TextChanged="OnPropertyEdited" />

                        <CheckBox x:Name="VisibleCheck" Content="可见" Click="OnVisibleToggled" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border
            Grid.Row="2"
            Height="26"
            Background="#CC121316">
            <TextBlock
                x:Name="StatusText"
                Margin="12,0"
                VerticalAlignment="Center"
                FontSize="12"
                Opacity="0.75"
                Text="就绪" />
        </Border>
    </Grid>
</Window>
